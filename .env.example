# 한국투자증권 API (https://apiportal.koreainvestment.com/)
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCOUNT_NO=12345678-01        # 계좌번호 (조회용, 선택)
KIS_IS_VIRTUAL=false              # true = 모의투자, false = 실전투자

# 카카오 API (https://developers.kakao.com/)
# 내 앱 > 앱 설정 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key
# 내 앱 > 제품 설정 > 카카오 로그인 > 보안 > Client Secret
KAKAO_CLIENT_SECRET=your_kakao_client_secret
# 토큰 발급 방법: setup.py --kakao-auth 실행
KAKAO_ACCESS_TOKEN=your_kakao_access_token
KAKAO_REFRESH_TOKEN=your_kakao_refresh_token

# 네이버 검색 API (https://developers.naver.com/)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Anthropic API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key
